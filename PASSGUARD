# 3. GUI EVENT HANDLERS
# ==========================================

def live_check(event=None):
    """
    Checks password strength while the user types.
    """

    password = password_entry.get()
    person_name = name_entry.get()

    score, label, tips = check_strength(
        password,
        person_name
    )

    strength_var.set(score)
    result_label.config(
        text=label,
        fg=COLOURS.get(label, "black")
    )

    score_label.config(
        text=f"Score: {score}/6"
    )

    if tips:
        tips_label.config(
            text="Tips:\n" + "\n".join(
                "• " + tip for tip in tips
            )
        )
    else:
        tips_label.config(
            text="Excellent! Your password meets all the checks."
        )


def on_check():
    """
    Saves the password check to history.
    """

    password = password_entry.get()

    if not password:
        messagebox.showwarning(
            "Empty Password",
            "Please enter a password first."
        )
        return

    person_name = name_entry.get()

    score, label, tips = check_strength(
        password,
        person_name
    )

    save_to_log(password, score, label)

    messagebox.showinfo(
        "Password Check Saved",
        "Your password check has been saved."
    )

    refresh_history()


def toggle_show():
    """
    Shows or hides the password.
    """

    if show_var.get():
        password_entry.config(show="")
    else:
        password_entry.config(show="*")


def on_generate():
    """
    Generates a strong password.
    """

    try:
        length = int(length_var.get())

        if length < 8 or length > 32:
            messagebox.showwarning(
                "Invalid Length",
                "Password length must be between 8 and 32."
            )
            return

        generated = generate_password(length)

        generated_var.set(generated)

    except ValueError:
        messagebox.showerror(
            "Invalid Input",
            "Please enter a valid password length."
        )


def on_copy():
    """
    Copies the generated password to the clipboard.
    """

    generated = generated_var.get()

    if not generated:
        messagebox.showwarning(
            "No Password",
            "Generate a password first."
        )
        return

    root.clipboard_clear()
    root.clipboard_append(generated)
    root.update()

    messagebox.showinfo(
        "Copied",
        "Password copied to clipboard."
    )


# EXTENSION 2: USE GENERATED PASSWORD

def use_generated_password():
    """
    Places the generated password into the checker
    and automatically checks its strength.
    """

    generated = generated_var.get()

    if not generated:
        messagebox.showwarning(
            "No Password",
            "Generate a password first."
        )
        return

    password_entry.delete(0, tk.END)
    password_entry.insert(0, generated)

    live_check()


def on_hash():
    """
    Generates the SHA-256 hash of the entered password.
    """

    password = password_entry.get()

    if not password:
        messagebox.showwarning(
            "Empty Password",
            "Enter a password before hashing."
        )
        return

    hashed = hash_password(password)

    hash_var.set(hashed)


# EXTENSION 1: CLEAR HISTORY

def clear_history():
    """
    Clears the history file and history list
    after asking for confirmation.
    """

    answer = messagebox.askyesno(
        "Clear History",
        "Are you sure you want to clear all password history?"
    )

    if answer:
        with open(LOG_FILE, "w") as file:
            file.write("")

        history_listbox.delete(0, tk.END)

        messagebox.showinfo(
            "History Cleared",
            "Password history has been cleared."
        )


def refresh_history():
    """
    Reloads the history list.
    """

    history_listbox.delete(0, tk.END)

    records = load_log()

    for record in records:
        history_listbox.insert(
            tk.END,
            record.strip()
        )


