dark_mode = False


def change_theme():
    """
    EXTENSION 5:
    Switches the application between light and dark mode.
    """

    global dark_mode

    dark_mode = dark_var.get()

    if dark_mode:
        background = "#222222"
        foreground = "white"
        entry_background = "#444444"
        button_background = "#333333"
    else:
        background = "#f0f0f0"
        foreground = "black"
        entry_background = "white"
        button_background = "#e0e0e0"

    root.config(bg=background)

    # Update all widgets
    def update_widgets(widget):

        widget_type = widget.winfo_class()

        try:
            if widget_type in ("Frame", "Labelframe"):
                widget.config(bg=background)

            elif widget_type == "Label":
                widget.config(
                    bg=background,
                    fg=foreground
                )

            elif widget_type == "Entry":
                widget.config(
                    bg=entry_background,
                    fg=foreground,
                    insertbackground=foreground
                )

            elif widget_type == "Button":
                widget.config(
                    bg=button_background,
                    fg=foreground,
                    activebackground=background,
                    activeforeground=foreground
                )

            elif widget_type in ("Checkbutton", "Radiobutton"):
                widget.config(
                    bg=background,
                    fg=foreground,
                    activebackground=background,
                    activeforeground=foreground,
                    selectcolor=entry_background
                )

            elif widget_type == "Listbox":
                widget.config(
                    bg=entry_background,
                    fg=foreground
                )

        except tk.TclError:
            pass

        for child in widget.winfo_children():
            update_widgets(child)

    update_widgets(root)

    # Update progress bar style
    if dark_mode:
        style.configure(
            "PassGuard.Horizontal.TProgressbar",
            troughcolor="#444444",
            background="green"
        )
    else:
        style.configure(
            "PassGuard.Horizontal.TProgressbar",
            troughcolor="white",
            background="green"
        )


