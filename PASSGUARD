# ==========================================
# 1. CONSTANTS
# ==========================================

LOG_FILE = "passguard_log.txt"

COMMON_PASSWORDS = [
    "password",
    "123456",
    "123456789",
    "qwerty",
    "abc123",
    "111111",
    "admin",
    "letmein",
    "welcome"
]

COLOURS = {
    "VERY WEAK": "red",
    "WEAK": "orange",
    "MEDIUM": "blue",
    "STRONG": "green"
}


# ==========================================
# 2. PASSWORD LOGIC FUNCTIONS(No GUI codes here)
# ==========================================

def check_strength(password, person_name=""):
    """
    Checks password strength and returns:
    score, label and improvement tips.
    """

    score = 0
    tips = []

    # Check for empty password
    if not password:
        return 0, "VERY WEAK", ["Enter a password."]

    # Check common passwords
    if password.lower() in COMMON_PASSWORDS:
        return 0, "VERY WEAK", [
            "This is a commonly used password. Choose another one."
        ]

    # Length check
    if len(password) >= 12:
        score += 2
    elif len(password) >= 8:
        score += 1
        tips.append("Use at least 12 characters.")
    else:
        tips.append("Use at least 8 characters.")

    # Uppercase check
    if any(char.isupper() for char in password):
        score += 1
    else:
        tips.append("Add an uppercase letter.")

    # Lowercase check
    if any(char.islower() for char in password):
        score += 1
    else:
        tips.append("Add a lowercase letter.")

    # Digit check
    if any(char.isdigit() for char in password):
        score += 1
    else:
        tips.append("Add a number.")

    # Special character check
    if any(char in string.punctuation for char in password):
        score += 1
    else:
        tips.append("Add a special character.")

    # EXTENSION 3: No three identical characters in a row
    if re.search(r"(.)\1\1", password):
        score = max(0, score - 1)
        tips.append(
            "Avoid three identical characters appearing consecutively."
        )

    # EXTENSION 4: Personal information check
    if person_name.strip():
        name_parts = person_name.lower().split()

        for part in name_parts:
            if len(part) >= 2 and part in password.lower():
                tips.append(
                    "Warning: Your password contains part of your name. "
                    "Avoid using personal information."
                )
                break

    # Determine password label
    if score <= 2:
        label = "WEAK"
    elif score <= 4:
        label = "MEDIUM"
    else:
        label = "STRONG"

    return score, label, tips


def generate_password(length=16):
    """
    Generates a strong random password using secrets.
    """

    characters = (
        string.ascii_letters
        + string.digits
        + string.punctuation
    )

    while True:
        password = "".join(
            secrets.choice(characters)
            for _ in range(length)
        )

        score, label, tips = check_strength(password)

        if label == "STRONG":
            return password


def hash_password(password):
    """
    Creates a SHA-256 hash of a password.
    """

    return hashlib.sha256(
        password.encode()
    ).hexdigest()


def save_to_log(password, score, label):
    """
    this saves the information of the password but not the exact password
    """

    password_hash = hash_password(password)[:10]

    timestamp = datetime.datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    record = (
        f"{timestamp} | "
        f"Hash: {password_hash} | "
        f"Score: {score}/6 | "
        f"{label}\n"
    )

    with open(LOG_FILE, "a") as file:
        file.write(record)


def load_log():
    """
    Loads previously saved password history.
    """

    try:
        with open(LOG_FILE, "r") as file:
            return file.readlines()

    except FileNotFoundError:
        return []


